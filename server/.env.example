# Node server
HOST=127.0.0.1
PORT=3000
PUBLIC_URL=http://localhost:3000

# Optional HTTP Basic Auth (leave empty to disable)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Path to the Python interpreter that has engine deps installed.
# On this machine the engine venv is used by default (see src/config.ts).
PYTHON_PATH=

# Directories (relative to repo root unless absolute)
ENGINE_DIR=engine
REGISTRY_PATH=registry
RUNS_PATH=runs

# Default row count for FK-parent tables auto-included but not explicitly selected
DEFAULT_PARENT_ROWS=100

UPLOADS_PATH=uploads
DRAFTS_PATH=uploads/drafts

# Anthropic (optional — rule-based fallback when unset)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
