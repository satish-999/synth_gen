# SynthGen — production / network deployment
# Copy to .env and adjust for your environment.

# Bind address: 127.0.0.1 (local only) or 0.0.0.0 (all interfaces / LAN / Docker)
HOST=0.0.0.0
PORT=3080

# Public URL shown in logs and health check (no trailing slash)
PUBLIC_URL=https://synthgen.example.com

# Optional HTTP Basic Auth (leave empty to disable)
BASIC_AUTH_USER=
BASIC_AUTH_PASS=

# Python
PYTHON_PATH=

# Paths (absolute or relative to repo root)
ENGINE_DIR=engine
REGISTRY_PATH=registry
RUNS_PATH=runs
UPLOADS_PATH=uploads
DRAFTS_PATH=uploads/drafts
DEFAULT_PARENT_ROWS=100

# Anthropic (optional)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
